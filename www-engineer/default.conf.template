map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${SERVER_PORT};
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Authorization "";
    set $chorus_lab_backend_template ${CHORUS_LAB_BACKEND_TEMPLATE};
    set $chorus_sql_backend_template ${CHORUS_SQL_BACKEND_TEMPLATE};
    set $chorus_ecl_backend_template ${CHORUS_ECL_BACKEND_TEMPLATE};
    set $chorus_iveapi_backend ${CHORUS_IVEAPI_BACKEND};
    set $chorus_iveapi_secret ${CHORUS_IVEAPI_SECRET};
    set $authenticated_user $http_x_ms_client_principal_name;
    if ($authenticated_user = '') {
        set $authenticated_user ${REMOTE_USER};
    }
    js_var $protected_uri $uri;
    if ($protected_uri) {
    }
    otel_span_attr authenticated_user $authenticated_user;
    auth_request /authorize;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        autoindex on;
        expires epoch;
    }

    location /dash/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass ${CHORUS_DASH_PUBLIC_BACKEND};
    }

    location /dash2/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass ${CHORUS_DASH_DATA_BACKEND};
    }

    location /dash3/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass ${CHORUS_DASH_USERS_BACKEND};
    }

    location = /lab/ {
       js_content http.redirect_to_default_lab;
    }

    location /lab/ {
        resolver ${NGINX_LOCAL_RESOLVERS};
        js_set $chorus_lab_backend http.get_chorus_lab_backend;
        proxy_pass $chorus_lab_backend$uri$is_args$args;
        proxy_redirect $chorus_lab_backend/ /;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location /sqlworkbench {
        resolver ${NGINX_LOCAL_RESOLVERS};
        js_set $chorus_sql_backend http.get_chorus_sql_backend;
        rewrite /sqlworkbench/(.*) /$1 break;
        proxy_pass $chorus_sql_backend/$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location /eclipse {
        resolver ${NGINX_LOCAL_RESOLVERS};
        js_set $chorus_ecl_backend http.get_chorus_ecl_backend;
        rewrite /eclipse/(.*) /$1 break;
        proxy_pass $chorus_ecl_backend/$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    location /webapi/ {
        proxy_pass ${CHORUS_WEBAPI_BACKEND};
    }

    location = /authorize {
        internal;
        js_content http.authorize;
    }

    location = /whoami {
        js_content http.whoami;
    }

    location /ive {
        resolver ${NGINX_LOCAL_RESOLVERS};
        js_set $ive_backend http.get_ive_backend;
        proxy_pass $ive_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }

    # OMOPCompass (mcp-snowflake). The app serves at "/" and builds its links
    # from X-Forwarded-Prefix (werkzeug ProxyFix), so nginx strips the prefix
    # (proxy_pass URL ends in "/") and tells the app where it lives.
    location = /omopcompass {
        return 301 /omopcompass/;
    }

    location /omopcompass/ {
        proxy_pass ${CHORUS_OMOPCOMPASS_BACKEND};
        proxy_set_header X-Forwarded-Prefix /omopcompass;
        proxy_set_header X-Forwarded-Proto  https;
        proxy_set_header X-Forwarded-Host   $host;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # LLM SQL generation and queries over the Azure OMOP link can take minutes
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
